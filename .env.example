# Onde os modelos .xkt ficam. Fora do repositório de propósito: modelo de
# cliente não se versiona, e o XKT é um artefato gerado (dá para refazer a
# partir do IFC a qualquer momento).
MODELS_DIR=var/app-data/models

# Endereço do backend Python que faz a conversão (backend/main.py).
BACKEND_URL=http://localhost:9000

# Limite de tamanho do upload, em MB (lido pelo backend).
IFC_MAX_MB=500

# Pipeline proprietário opcional (cxconverter/ifc2gltf). Sem estas variáveis o
# backend usa o pipeline community (open source). Leia a seção de licenças do
# README antes de usar: a versão gratuita do ifc2gltf é de avaliação e embute
# marca d'água invisível na geometria.
#CXCONVERTER_PATH=C:/caminho/para/cxconverter.exe

# Caminho do JS do convert2xkt, quando o pacote npm não está no local padrão.
#CONVERT2XKT_JS=/usr/local/lib/node_modules/@xeokit/xeokit-convert/convert2xkt.js
